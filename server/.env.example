PORT=5000
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
ADMIN_KEY=choose-a-long-random-secret
# Comma-separated list of allowed frontend origins (leave empty to allow all in dev)
CORS_ORIGIN=http://localhost:5173

# --- AI image extraction (Google AI Studio free key) ---
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash
# false = only people with ADMIN_KEY can upload images / create exams
# true  = anyone can (rate limited per IP per hour by the two limits below)
PUBLIC_CREATE=false
EXTRACT_LIMIT=10
CREATE_LIMIT=20
